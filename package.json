{
  "name": "dsh-sdd-kit",
  "version": "0.5.1",
  "description": "Zero-fork SDD bridge plugin for DeepSeek Harness (DSH): delegates 'what to build' to upstream GitHub Spec Kit (specify CLI) and 'how to build' to upstream obra/superpowers, with EARS/Non-Goals overrides, strict TDD, and atomic commits.",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.mjs",
  "bin": {
    "sdd-kit": "./bin/sdd-kit.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "bin/",
    "skills/",
    "overrides/",
    "spec-kit-extension/",
    "docs/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sdd",
    "spec-kit",
    "superpowers",
    "tdd",
    "skills"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.1.0",
    "@deepseek-ai/dsh-skill-filesystem": ">=0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill-filesystem": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:contract": "node --test test/contract-*.test.mjs",
    "test:adapters": "node --test test/adapters*.test.mjs",
    "verify:upstream": "node scripts/verify-upstream.mjs",
    "verify:compat": "node --test test/compat.test.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
